@model IReadOnlyList<ClinicListItemDto>
@{
    ViewData["Title"] = "Klinikler";
}

<div class="admin-page-head">
    <div>
        <h1>Klinikler</h1>
        <p>Veteriner kliniklerini, çalışma saatlerini ve bağlı hizmetleri yönetin.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">Yeni Klinik Ekle</a>
</div>

<section class="admin-panel-card">
    @if (Model.Count == 0)
    {
        <div class="admin-empty-state">
            <p>Henüz tanımlı bir klinik bulunmuyor.</p>
            <a class="btn btn-primary btn-sm" asp-action="Create">İlk kliniği oluştur</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table admin-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Klinik Adı</th>
                        <th>Adres</th>
                        <th class="text-center">Çalışma Saati</th>
                        <th class="text-center">Hizmet</th>
                        <th class="text-center">Hekim</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var clinic in Model)
                    {
                        <tr>
                            <td><strong>@clinic.Name</strong></td>
                            <td class="text-muted">@clinic.Address</td>
                            <td class="text-center">@clinic.WorkingHourCount</td>
                            <td class="text-center">@clinic.ServiceCount</td>
                            <td class="text-center">@clinic.VeterinarianCount</td>
                            <td class="text-end">
                                <div class="admin-row-actions">
                                    <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@clinic.Id">Detay</a>
                                    <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@clinic.Id">Düzenle</a>
                                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@clinic.Id">Sil</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>