@model ClinicDetailDto
@{
    ViewData["Title"] = Model.Name;
}

<div class="admin-page-head">
    <div>
        <h1>@Model.Name</h1>
        <p>@Model.Address</p>
    </div>
    <div class="admin-row-actions">
        <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@Model.Id">Kliniği Düzenle</a>
        <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@Model.Id">Sil</a>
        <a class="btn btn-outline-primary" asp-action="Index">Listeye Dön</a>
    </div>
</div>

<section class="admin-panel-card">
    <div class="admin-card-head">
        <h2>Çalışma Saatleri</h2>
        <a class="btn btn-primary btn-sm" asp-controller="WorkingHours" asp-action="Create" asp-route-clinicId="@Model.Id">
            Çalışma Saati Ekle
        </a>
    </div>

    @if (Model.WorkingHours.Count == 0)
    {
        <p class="text-muted mb-0">Bu klinik için henüz çalışma saati tanımlanmadı.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table admin-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Gün</th>
                        <th>Açılış</th>
                        <th>Kapanış</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var hour in Model.WorkingHours)
                    {
                        <tr>
                            <td><strong>@DayOfWeekHelper.GetTurkishName(hour.DayOfWeek)</strong></td>
                            <td>@hour.OpensAt.ToString("HH:mm")</td>
                            <td>@hour.ClosesAt.ToString("HH:mm")</td>
                            <td class="text-end">
                                <div class="admin-row-actions">
                                    <a class="btn btn-sm btn-outline-secondary"
                                       asp-controller="WorkingHours" asp-action="Edit" asp-route-id="@hour.Id">Düzenle</a>
                                    <a class="btn btn-sm btn-outline-danger"
                                       asp-controller="WorkingHours" asp-action="Delete" asp-route-id="@hour.Id">Sil</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="admin-panel-card">
    <div class="admin-card-head">
        <h2>Klinik Hizmetleri</h2>
        <a class="btn btn-primary btn-sm" asp-controller="Services" asp-action="Create" asp-route-clinicId="@Model.Id">
            Hizmet Ekle
        </a>
    </div>

    @if (Model.Services.Count == 0)
    {
        <p class="text-muted mb-0">Bu klinik için henüz hizmet tanımlanmadı.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table admin-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Hizmet Adı</th>
                        <th>Süre</th>
                        <th>Ücret</th>
                        <th class="text-center">Atanan Hekim</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var service in Model.Services)
                    {
                        <tr>
                            <td><strong>@service.Name</strong></td>
                            <td>@service.DurationMinutes dk</td>
                            <td>@service.Fee.ToString("N2", CultureInfo.GetCultureInfo("tr-TR")) TL</td>
                            <td class="text-center">@service.AssignedVeterinarianCount</td>
                            <td class="text-end">
                                <div class="admin-row-actions">
                                    <a class="btn btn-sm btn-outline-secondary"
                                       asp-controller="Services" asp-action="Edit" asp-route-id="@service.Id">Düzenle</a>
                                    <a class="btn btn-sm btn-outline-danger"
                                       asp-controller="Services" asp-action="Delete" asp-route-id="@service.Id">Sil</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>