@model ClinicServiceFormViewModel
@{
    ViewData["Title"] = "Yeni Hizmet";
}

<div class="admin-page-head">
    <div>
        <h1>Yeni Hizmet Ekle</h1>
        <p>Hizmetin bağlı olduğu kliniği, süresini ve ücretini belirleyin.</p>
    </div>
    <a class="btn btn-outline-primary" asp-action="Index">Listeye Dön</a>
</div>

<section class="admin-panel-card admin-form-card">
    <form asp-action="Create" method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <div class="mb-3">
            <label asp-for="ClinicId" class="form-label"></label>
            <select asp-for="ClinicId" asp-items="Model.ClinicOptions" class="form-select"></select>
            <span asp-validation-for="ClinicId" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" placeholder="Örn: Genel Muayene, Karma Aşı, Diş Temizliği" />
            <span asp-validation-for="Name" class="text-danger small"></span>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-sm-6">
                <label asp-for="DurationMinutes" class="form-label"></label>
                <input asp-for="DurationMinutes" type="number" min="1" max="1440" class="form-control" />
                <span asp-validation-for="DurationMinutes" class="text-danger small"></span>
            </div>
            <div class="col-sm-6">
                <label asp-for="Fee" class="form-label"></label>
                <input asp-for="Fee" type="number" step="0.01" min="0"
                       value="@Model.Fee.ToString("0.##", CultureInfo.InvariantCulture)" class="form-control" />
                <span asp-validation-for="Fee" class="text-danger small"></span>
            </div>
        </div>

        <div class="admin-row-actions">
            <button type="submit" class="btn btn-primary">Kaydet</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Vazgeç</a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}