@model ClinicServiceItemDto
@{
    ViewData["Title"] = "Hizmet Sil";
}

<div class="admin-page-head">
    <div>
        <h1>Hizmet Sil</h1>
        <p>Bu hizmeti silmek istediğinizden emin misiniz?</p>
    </div>
    <a class="btn btn-outline-primary" asp-action="Index" asp-route-clinicId="@Model.ClinicId">Listeye Dön</a>
</div>

<section class="admin-panel-card admin-form-card">
    <dl class="admin-metric-list mb-4">
        <div>
            <dt>Hizmet Adı</dt>
            <dd><strong>@Model.Name</strong></dd>
        </div>
        <div>
            <dt>Klinik</dt>
            <dd>@Model.ClinicName</dd>
        </div>
        <div>
            <dt>Süre</dt>
            <dd>@Model.DurationMinutes dk</dd>
        </div>
        <div>
            <dt>Ücret</dt>
            <dd>@Model.Fee.ToString("N2", CultureInfo.GetCultureInfo("tr-TR")) TL</dd>
        </div>
        <div>
            <dt>Atanan Hekim Sayısı</dt>
            <dd>@Model.AssignedVeterinarianCount</dd>
        </div>
    </dl>

    <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
        <div class="admin-row-actions">
            <button type="submit" class="btn btn-danger">Evet, Hizmeti Sil</button>
            <a class="btn btn-outline-secondary" asp-action="Index" asp-route-clinicId="@Model.ClinicId">Vazgeç</a>
        </div>
    </form>
</section>